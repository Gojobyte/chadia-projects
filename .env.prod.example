# =====================================================================
# Variables d'environnement de PRODUCTION pour CHADIA Projects
#
# Copier ce fichier vers `.env.prod` (qui est gitignored) et remplir les
# valeurs avec :
#   bash scripts/generate-prod-secrets.sh
# =====================================================================

# --- Postgres (mot de passe DB) ---
POSTGRES_PASSWORD=

# --- Auth · JWT signing secret (auth-service) ---
# Doit faire 64+ caractères aléatoires.
JWT_SECRET=

# --- NextAuth · session signing secret (gateway) ---
# Doit faire 64+ caractères aléatoires.
NEXTAUTH_SECRET=

# --- Token de communication inter-services ---
# Présent dans tous les services pour les appels machine-to-machine.
INTERNAL_SERVICE_TOKEN=

# --- Compte super-admin créé au seed ---
SUPER_ADMIN_EMAIL=admin@ong-chadia.com
SUPER_ADMIN_PASSWORD=

# --- URL publique de la plateforme (vue depuis Internet) ---
# Phase 1 : IP nue.   Phase 2 : remplacer par le domaine + https.
PUBLIC_URL=https://ong-chadia.com

# --- Resend (notifications email) ---
# Récupérer la clé sur https://resend.com/api-keys
RESEND_API_KEY=

# --- Google OAuth (optionnel · login Google) ---
# Laisser vide pour désactiver le bouton "Continuer avec Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
