# =====================================================================
# Caddyfile · CHADIA Projects
#
# Caddy obtient automatiquement les certificats Let's Encrypt pour
# ong-chadia.com dès que les DNS pointeront vers ce serveur. La résolution
# du défi ACME utilise le port 80 — il doit donc être ouvert.
# =====================================================================

{
    # Email pour les notifications Let's Encrypt (expiration de cert, etc.).
    email chadiaong@gmail.com

    # Logs JSON sur stdout (Docker capture automatiquement).
    log {
        output stdout
        format json
        level INFO
    }
}

# Domaine principal · racine + www, avec HTTPS auto.
ong-chadia.com, www.ong-chadia.com {
    # Reverse proxy vers le gateway Next.js dans le network Docker.
    reverse_proxy gateway:3000

    # Compression gzip pour réduire le poids des pages servies.
    encode gzip

    # En-têtes de sécurité (Caddy ajoute déjà Strict-Transport-Security
    # automatiquement quand HTTPS est actif).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    log {
        output stdout
    }
}

# Accès direct par IP — fallback HTTP, utile pour debug et tests internes.
# Tant que les DNS ne sont pas propagés, on continue à servir sur l'IP nue.
http://188.245.42.63 {
    reverse_proxy gateway:3000
    encode gzip
}
