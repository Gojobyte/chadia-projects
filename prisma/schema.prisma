// ============================================================
// CHADIA Projects — Schema Prisma
// Plateforme de montage de projets / reponse aux appels d'offres
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// UTILISATEURS & AUTH
// ============================================================

enum UserRole {
  DIRECTEUR
  ADMIN
  FINANCIER
  MEMBRE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(MEMBRE)
  image        String?
  googleId     String?  @unique

  projetsCreated    Projet[]       @relation("ProjetCreatedBy")
  memberships       ProjetMembre[]
  tachesAssignees   Tache[]        @relation("TacheAssignee")
  documentsAssignes Document[]     @relation("DocumentAssigne")
  activites         Activite[]
  notifications     Notification[]
  commentaires      Commentaire[]
  accounts          Account[]
  sessions          Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// PROJETS (Appels d'offres)
// ============================================================

enum ProjetStatut {
  BROUILLON
  EN_COURS
  EN_REVISION
  SOUMIS
  ACCEPTE
  REJETE
  ARCHIVE
}

model Projet {
  id          String       @id @default(cuid())
  titre       String
  reference   String?
  description String       @db.Text
  objectifs   String?      @db.Text

  bailleurId  String
  bailleur    Bailleur     @relation(fields: [bailleurId], references: [id])

  budget      Float?
  devise      String       @default("FCFA")

  datePublication DateTime?
  dateLimite      DateTime
  statut          ProjetStatut @default(BROUILLON)

  appelOffreUrl String?

  createdBy   User   @relation("ProjetCreatedBy", fields: [createdById], references: [id])
  createdById String

  documents    Document[]
  taches       Tache[]
  membres      ProjetMembre[]
  activites    Activite[]
  commentaires Commentaire[]
  analyseIA    AnalyseIA?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([statut])
  @@index([dateLimite])
  @@map("projets")
}

enum ProjetRole {
  DIRECTEUR
  ADMIN
  FINANCIER
  MEMBRE
}

model ProjetMembre {
  id       String     @id @default(cuid())
  projetId String
  userId   String
  role     ProjetRole @default(MEMBRE)
  projet   Projet     @relation(fields: [projetId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projetId, userId])
  @@map("projet_membres")
}

// ============================================================
// DOCUMENTS
// ============================================================

enum DocumentCategorie {
  PROPOSITION_TECHNIQUE
  BUDGET_PREVISIONNEL
  BUDGET_DETAIL
  CADRE_LOGIQUE
  NOTE_CONCEPTUELLE
  PLAN_TRAVAIL
  GANTT
  CV
  DOCUMENT_LEGAL
  AUTRE
}

enum DocumentStatut {
  BROUILLON
  REDACTION
  RELECTURE
  VALIDATION
  FINALISATION
  VALIDE
}

model Document {
  id          String             @id @default(cuid())
  projetId    String
  categorie   DocumentCategorie
  titre       String
  description String?
  contenu     String?            @db.Text
  fichierUrl  String?
  statut      DocumentStatut     @default(BROUILLON)
  ordre       Int                @default(0)
  assigneAId  String?
  dateLimite  DateTime?
  progression Int                @default(0)

  projet       Projet        @relation(fields: [projetId], references: [id], onDelete: Cascade)
  assigneA     User?         @relation("DocumentAssigne", fields: [assigneAId], references: [id])
  taches       Tache[]
  commentaires Commentaire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projetId, categorie])
  @@map("documents")
}

// ============================================================
// TACHES
// ============================================================

enum TachePriorite {
  HAUTE
  MOYENNE
  BASSE
}

enum TacheStatut {
  A_FAIRE
  EN_COURS
  TERMINE
}

model Tache {
  id          String        @id @default(cuid())
  projetId    String
  documentId  String?
  titre       String
  description String?
  statut      TacheStatut   @default(A_FAIRE)
  priorite    TachePriorite @default(MOYENNE)
  dateLimite  DateTime?
  assigneAId  String?

  projet   Projet    @relation(fields: [projetId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  assigneA User?     @relation("TacheAssignee", fields: [assigneAId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([projetId])
  @@index([assigneAId])
  @@map("taches")
}

// ============================================================
// COMMENTAIRES
// ============================================================

model Commentaire {
  id          String  @id @default(cuid())
  contenu     String  @db.Text
  documentId  String?
  tacheId     String?
  projetId    String
  userId      String

  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projet   Projet    @relation(fields: [projetId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  @@index([documentId])
  @@index([projetId])
  @@map("commentaires")
}

// ============================================================
// ANALYSE IA
// ============================================================

model AnalyseIA {
  id        String @id @default(cuid())
  projetId  String @unique
  appelOffreTexte String? @db.Text
  criteres  String? @db.Text
  exigences String? @db.Text
  documentsRequis String? @db.Text
  budgetEstime String?
  recommandations String? @db.Text
  scoreConformite Int?

  projet Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("analyses_ia")
}

// ============================================================
// BAILLEURS, TEMPLATES, ACTIVITES, NOTIFICATIONS
// ============================================================

model Bailleur {
  id      String  @id @default(cuid())
  nom     String
  sigle   String  @unique
  logoUrl String?
  siteWeb String?
  projets Projet[]
  @@map("bailleurs")
}

model Template {
  id          String            @id @default(cuid())
  categorie   DocumentCategorie
  titre       String
  description String?
  contenu     String            @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@map("templates")
}

model Activite {
  id          String @id @default(cuid())
  projetId    String
  userId      String
  action      String
  description String
  projet      Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)
  user        User   @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  @@index([projetId])
  @@index([createdAt])
  @@map("activites")
}

model Notification {
  id        String  @id @default(cuid())
  userId    String
  titre     String
  message   String
  lien      String?
  lu        Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([userId, lu])
  @@map("notifications")
}
