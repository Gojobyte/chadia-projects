generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DIRECTEUR
  ADMIN
  FINANCIER
  MEMBRE
}

// Instance de gouvernance à laquelle le membre appartient.
// CA = Conseil d'administration · BUREAU = Bureau Exécutif
// PROGRAMMES = équipe opérationnelle · VOLONTAIRE = service civique / stagiaire
enum UserInstance {
  CA
  BUREAU
  PROGRAMMES
  VOLONTAIRE
  EXTERNE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(MEMBRE)
  image        String?
  googleId     String?  @unique
  isActive     Boolean  @default(true)

  // Informations métier ONG CHADIA
  fonction      String?         // Coordinateur, Trésorier, Responsable communication...
  zone          String?         // N'Djamena, Mongo, Bitkine...
  telephone     String?
  instance      UserInstance    @default(PROGRAMMES)
  dateEmbauche  DateTime?
  bio           String?         // Phrase courte affichée sur /equipe

  sessions     Session[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([instance])
  @@index([isActive])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id          String   @id @default(cuid())
  token       String   @unique
  userId      String
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  details   Json?
  ip        String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ServiceToken {
  id          String   @id @default(cuid())
  serviceName String   @unique
  token       String   @unique
  scopes      String[] // ["tender:read", "tender:write", "notification:send"]
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@map("service_tokens")
}
