generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// BAILLEURS
// ============================================================
// CHADIA est CANDIDATE auprès de ces bailleurs internationaux.
// Sources potentielles d'opportunités (à venir : modèle Opportunite).

model Bailleur {
  id            String        @id @default(cuid())
  nom           String
  sigle         String        @unique
  logoUrl       String?
  siteWeb       String?
  rulesJson     Json?
  promptHints   String?

  opportunites  Opportunite[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("bailleurs")
}

// ============================================================
// DOCUMENTS
// ============================================================
// Pièces jointes attachées soit à un projet, soit à la bibliothèque
// libre (lib). Les futurs modèles Opportunite/Candidature pourront
// référencer des documents via leur propre FK quand ils existeront.

enum DocumentType {
  TDR
  SOUMISSION_TECHNIQUE
  SOUMISSION_FINANCIERE
  CONTRAT
  RAPPORT_ACTIVITE
  BUDGET
  STATUT
  MANUEL
  PROCES_VERBAL
  PHOTO_TERRAIN
  TEMPLATE
  AUTRE
}

enum DocumentCategory {
  MODELES_AO
  STATUTS_JURIDIQUE
  PROJETS
  CONVENTIONS_BAILLEURS
  COMPTABILITE
  MEDIAS_TERRAIN
  RAPPORTS
  AUTRE
}

enum DocumentVisibility {
  PUBLIC
  INTERNE
  CONFIDENTIEL
}

model Document {
  id              String             @id @default(cuid())
  nom             String
  originalName    String?
  type            DocumentType       @default(AUTRE)
  category        DocumentCategory   @default(AUTRE)
  visibility      DocumentVisibility @default(INTERNE)
  mimeType        String?
  taille          Int?
  url             String
  cheminLocal     String?
  hash            String?
  version         String?            @default("1.0")
  tags            String[]           @default([])
  isPinned        Boolean            @default(false)
  description     String?

  // Rattachements optionnels (au moins l'un des trois sur les nouvelles entités)
  projetId        String?
  opportuniteId   String?
  opportunite     Opportunite?  @relation(fields: [opportuniteId], references: [id], onDelete: SetNull)
  candidatureId   String?
  candidature     Candidature?  @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  // Rattachement direct à une pièce de l'arborescence (cf piecesRequises +
  // piecesOverrides). Le matching est ainsi explicite — pas de fragile
  // recherche par tags comme avant (audit P0-3).
  pieceId         String?

  uploadedBy      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([projetId])
  @@index([opportuniteId])
  @@index([candidatureId])
  @@index([pieceId])
  @@index([category])
  @@index([visibility])
  @@index([isPinned])
  @@index([type])
  @@map("documents")
}

// ============================================================
// OPPORTUNITÉS — appels à propositions ramenés par la veille
// ============================================================
// Une Opportunite est un snapshot immutable d'un appel à propositions
// repéré chez un bailleur (UE, ONU, BAD, USAID…) concernant le Tchad
// ou son aire géographique. Le couple (sourceConnector, sourceId)
// garantit l'unicité côté source pour la déduplication.
// Les statuts sont propres à CHADIA — ils tracent où on en est
// dans la décision : faut-il candidater ou pas ?

enum OpportuniteSource {
  TED            // Tenders Electronic Daily (UE)
  SAM_GOV        // System for Award Management (USA)
  WORLDBANK      // Banque Mondiale Procurement
  UNDP           // PNUD - Programme des Nations Unies pour le Développement
  RELIEFWEB      // OCHA — humanitaire
  UNGM           // UN Global Marketplace
  BAD            // Banque africaine de développement
  AFD            // Agence française de développement
  ECHO           // DG ECHO (Commission européenne)
  USAID
  MANUEL         // saisie à la main par un membre CHADIA
  AUTRE
}

enum OpportuniteStatut {
  NOUVELLE       // vient d'être collectée
  A_ETUDIER      // CHADIA s'y intéresse, analyse en cours
  IGNOREE        // décision : on ne candidate pas
  CANDIDATEE     // une Candidature a été créée pour répondre
  EXPIREE        // deadline passée sans décision
}

enum OpportuniteTypeFinancement {
  SUBVENTION                 // appel à propositions (grant)
  MARCHE_SERVICE
  MARCHE_TRAVAUX
  MARCHE_FOURNITURES
  CONSULTATION
  ASSISTANCE_TECHNIQUE
  AUTRE
}

model Opportunite {
  id                String                     @id @default(cuid())

  // Provenance (source externe)
  sourceConnector   OpportuniteSource          @default(MANUEL)
  sourceId          String?                    // identifiant natif chez la source (ex: TED notice number)
  sourceUrl         String?                    // URL de l'annonce d'origine
  rawPayload        Json?                      // snapshot brut pour debug

  // Bailleur (FK quand on a su mapper, sinon texte libre)
  bailleurId        String?
  bailleur          Bailleur?                  @relation(fields: [bailleurId], references: [id])
  bailleurNom       String?

  // Métadonnées de l'appel
  titre             String
  description       String?
  secteur           String?                    // libre : "Eau", "Santé maternelle", etc.
  typeFinancement   OpportuniteTypeFinancement @default(SUBVENTION)
  paysCible         String[]                   @default([])   // ISO ou noms : ["TCD"], ["Sahel"]
  region            String?
  montantEstime     Float?
  devise            String                     @default("EUR")

  datePublication   DateTime?
  dateLimiteDepot   DateTime?

  // Mots-clés extraits/saisis pour la recherche et le matching
  tags              String[]                   @default([])

  // Décision CHADIA
  statut            OpportuniteStatut          @default(NOUVELLE)
  decideePar        String?                    // userId qui a tranché
  decideeAt         DateTime?

  // Lien vers la candidature montée pour cette opportunité (1-1 optionnel)
  candidature       Candidature?

  documents         Document[]

  collecteAt        DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([sourceConnector, sourceId])
  @@index([statut])
  @@index([dateLimiteDepot])
  @@index([bailleurId])
  @@index([sourceConnector])
  @@map("opportunites")
}

// ============================================================
// CANDIDATURES — dossiers que CHADIA monte pour répondre
// ============================================================

enum CandidatureStatut {
  BROUILLON       // initialisée, peu de contenu
  EN_REDACTION    // équipe en train de monter le dossier
  EN_VALIDATION   // relecture interne avant envoi
  SOUMISE         // envoyée au bailleur
  ATTRIBUEE       // CHADIA a gagné
  NON_RETENUE     // CHADIA a perdu
  ABANDONNEE      // décision de ne plus continuer
}

model Candidature {
  id                String              @id @default(cuid())
  reference         String              @unique          // CAND-2026-001

  opportuniteId     String?             @unique          // 1-1 optionnel (candidature spontanée possible)
  opportunite       Opportunite?        @relation(fields: [opportuniteId], references: [id], onDelete: SetNull)

  titre             String
  description       String?

  statut            CandidatureStatut   @default(BROUILLON)

  // Pilotage interne
  coordinateurId    String?                              // userId responsable
  equipe            String[]            @default([])     // userIds ou initiales

  // Contenu du dossier (notes longues — chaque section éditable)
  noteConcept       String?                              // note conceptuelle
  methodologie     String?
  partenaires       String[]            @default([])

  // Surcouche locale par-dessus l'analyse Mistral de l'opportunité liée.
  // Permet à chaque candidature d'ajouter / modifier / retirer des pièces
  // SANS toucher à l'analyse partagée (qui vit sur Opportunite.rawPayload).
  // Forme attendue : { added: Piece[], updated: Record<id, Partial<Piece>>, removed: string[] }
  // La fusion se fait côté gateway dans buildPieces().
  piecesOverrides   Json?

  // Contenu rédigé par CHADIA pour chaque pièce de l'arborescence.
  // Map { pieceId: { html: string, updatedAt: ISO, savedBy: userId } }
  // Le pieceId correspond à l'id de la pièce (Mistral ou custom).
  // Sauvegardé en autosave côté client (debounce 1.5s).
  pieceContents     Json?

  // Q&A bailleur (V15 / P2-35). Tableau de questions posées au bailleur
  // (par CHADIA) ou par le bailleur (clarifications). Forme attendue :
  // Array<{ id, sens: "vers_bailleur"|"vers_chadia", question, reponse?,
  //         statut: "brouillon"|"pose"|"repondu", auteurId?, dateCreation,
  //         dateReponse?, source?: "officiel"|"informel" }>.
  qaThread          Json?

  // Volet financier
  budgetDemande     Float?
  coFinancement     Float?
  devise            String              @default("EUR")
  dureeMois         Int?

  // Calendrier
  dateDepotPrevu    DateTime?
  dateDepotEffectif DateTime?
  dateResultat      DateTime?

  // Retour du bailleur
  commentairesBailleur String?

  documents         Document[]

  createdBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([statut])
  @@index([opportuniteId])
  @@index([coordinateurId])
  @@map("candidatures")
}

// ============================================================
// PROJETS (programmes portés par l'ONG)
// ============================================================

enum ProjetStatut {
  MONTAGE
  ACTIF
  ACHEVE
  SUSPENDU
  ANNULE
}

enum ProjetDomaine {
  URGENCE
  JEUNESSE
  GENRE
  FEMMES
  EDUCATION
  EAU
  SANTE
  COHESION
  FORMATION
  AGRICULTURE
  AUTRE
}

model Projet {
  id              String        @id @default(cuid())
  reference       String        @unique
  titre           String
  description     String?
  zone            String?
  domaine         ProjetDomaine @default(AUTRE)
  statut          ProjetStatut  @default(MONTAGE)
  urgent          Boolean       @default(false)

  bailleurs       String[]      @default([])
  team            String[]      @default([])

  dateDebut       DateTime?
  dateFin         DateTime?
  dateCloture     DateTime?
  echeance        String?

  avancement      Int           @default(0)
  etapeLabel      String?

  budgetEstime    Float?
  budgetRealise   Float?
  devise          String        @default("FCFA")
  beneficiaires   Int?

  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([statut])
  @@index([domaine])
  @@index([zone])
  @@map("projets")
}

// ============================================================
// SETTINGS
// ============================================================

enum SettingCategory {
  ORGANIZATION
  BRANDING
  CONTACT
  WORKFLOW
  NUMEROTATION
  INTEGRATION
  OTHER
}

model Setting {
  id          String          @id @default(cuid())
  key         String          @unique
  value       Json
  category    SettingCategory @default(OTHER)
  label       String?
  description String?
  updatedBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([category])
  @@map("settings")
}

// ============================================================
// OUTBOX PATTERN (communication inter-services)
// ============================================================

model OutboxEvent {
  id          String   @id @default(cuid())
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([processed, createdAt])
  @@map("outbox_events")
}
